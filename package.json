{
  "name": "@pyrologic/pyrologjs",
  "version": "2.0.1",
  "author": "Thomas Hendel",
  "homepage": "https://github.com/pyrologic/pyrologjs",
  "license": "MIT",
  "description": "Lightweight JavaScript logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyrologic/pyrologjs.git"
  },
  "keywords": [
    "logging",
    "logger",
    "log",
    "logging-library",
    "javascript",
    "typescript",
    "pyrologic"
  ],
  "type": "module",
  "main": "dist/pyrolog.js",
  "types": "dist/pyrolog.d.ts",
  "exports": {
    ".": {
      "types": "./dist/pyrolog.d.ts",
      "import": "./dist/pyrolog.js"
    },
    "./min": {
      "types": "./dist/pyrolog.d.ts",
      "import": "./dist/pyrolog.min.js"
    },
    "./dist/pyrolog.min.js": {
      "types": "./dist/pyrolog.d.ts",
      "import": "./dist/pyrolog.min.js"
    }
  },
  "files": [
    "dist/pyrolog.js",
    "dist/pyrolog.d.ts",
    "dist/pyrolog.js.map",
    "dist/pyrolog.min.js",
    "dist/pyrolog.min.js.map"
  ],
  "scripts": {
    "watch": "rollup --config rollup.config.mjs --watch --watch.buildDelay 25",
    "build": "rollup --config rollup.config.mjs"
  },
  "devDependencies": {
    "@pyrologic/rollup-plugin": "^1.1.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^26.1.1",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
