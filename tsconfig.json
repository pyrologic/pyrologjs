{
    "include": ["src/**/*.ts"],
    "exclude": ["dist"],
    "compilerOptions": {
        "target": "es2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "declaration": true,
        "declarationDir": "dist/dts",
        "noUnusedLocals": true,
        "strict": true
    }
}